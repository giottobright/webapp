# Backend URL (FastAPI). Empty = auto-detect: app.example.com → api.example.com, localhost → :8000
VITE_API_BASE=https://api.example.com
# Optional CDN with persona originals (<base>/<code>1.png); bundled WebP photos are used first
VITE_ASSETS_BASE=
# Local development only (npm run dev): act as this Telegram user id outside Telegram.
# Needs the backend with ENV=dev DEV_BYPASS_INIT_DATA=1. Ignored in production builds.
VITE_DEV_USER_ID=
